<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>BIG BANG - Auto Miner</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{background:#02120a;color:#fff;font-family:Arial,sans-serif;text-align:center;padding-bottom:90px;overflow-x:hidden}
.header{padding:20px 10px 5px;font-size:32px;font-weight:900;color:#22ff88;text-shadow:0 0 20px #22ff88}
.balance-box{background:linear-gradient(135deg,#00e676,#00b248);margin:15px;border-radius:22px;padding:20px;color:#022c16;box-shadow:0 0 30px #00e67688}
.balance-box p{font-size:18px;font-weight:bold}
.balance-box h1{font-size:52px;line-height:1}
.balance-box span{font-size:18px;font-weight:bold}
.auto-box{background:#0a2e1a;border:2px solid #22ff88;margin:0 15px 15px;border-radius:18px;padding:14px}
.auto-box b{color:#22ff88;font-size:19px}
.auto-box p{font-size:14px;color:#b9ffd6;margin-top:5px}
.coin-wrap{position:relative;width:240px;height:240px;margin:15px auto}
.coin{width:100%;height:100%;background:radial-gradient(circle at 35% 30%,#a7ffcb,#22ff88 45%,#00a651 75%,#00692e);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:110px;border:8px solid #d2ffe2;box-shadow:0 0 60px #22ff88,0 0 120px #22ff8844;animation:pulse 2s infinite}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.05)}}
.mining{color:#22ff88;font-size:18px;font-weight:bold;margin:10px;animation:blink 1s infinite}
@keyframes blink{50%{opacity:.4}}
.energy{background:#0a2e1a;margin:10px 15px;padding:12px;border-radius:14px;font-size:18px}
.energy-bar{height:10px;background:#123322;border-radius:10px;margin:10px 15px;overflow:hidden}
.energy-fill{height:100%;background:#22ff88;width:100%;transition:width .3s}
.btn{background:#22ff88;color:#022c16;border:none;width:calc(100% - 30px);margin:8px 15px;padding:16px;border-radius:15px;font-size:18px;font-weight:900;cursor:pointer}
.btn2{background:#0a2e1a;color:#22ff88;border:2px solid #22ff88}
.nav{position:fixed;bottom:0;left:0;right:0;background:#02120a;border-top:2px solid #22ff88;display:flex;justify-content:space-around;padding:14px 0;font-size:15px}
.nav b{color:#22ff88}
.nav span{color:#8affb8}
.card{background:#0a2e1a;margin:12px 15px;padding:16px;border-radius:16px;text-align:left;border:1px solid #1e5a36}
.card b{color:#22ff88}
.hidden{display:none}
</style>
</head>
<body>
<div id="page-mine">
<div class="header">💥 BIG BANG 💥</div>
<div class="balance-box"><p>Your Balance</p><h1 id="bal">0</h1><span>BIG</span></div>
<div class="auto-box">⚡ <b>AUTO MINING ON</b><br><p>خودکار ماین میشود - نیاز به تب زدن نیست<br>+<span id="perSec">1</span> BIG در هر ثانیه</p></div>
<div class="coin-wrap"><div class="coin">💥</div></div>
<div class="mining">● در حال ماین خودکار...</div>
<div class="energy">⚡ Energy: <span id="energy">1000</span> / 1000</div>
<div class="energy-bar"><div class="energy-fill" id="energyBar"></div></div>
<button class="btn" onclick="claim()">🎁 Claim Daily Reward +100</button>
<button class="btn btn2" onclick="boost()">🚀 Boost Speed +1/sec (قیمت 200)</button>
</div>

<div id="page-tasks" class="hidden">
<div class="header">📋 Tasks</div>
<div class="card"><b>✅ Join Telegram Channel</b><p>+500 BIG</p><button class="btn" onclick="doTask(500,this)">Claim</button></div>
<div class="card"><b>✅ Follow on X</b><p>+300 BIG</p><button class="btn" onclick="doTask(300,this)">Claim</button></div>
<div class="card"><b>✅ Invite 3 Friends</b><p>+1000 BIG</p><button class="btn" onclick="doTask(1000,this)">Claim</button></div>
</div>

<div id="page-miners" class="hidden">
<div class="header">💎 Miners</div>
<div class="card"><b>⛏️ Basic Miner</b><p>+1 / sec - FREE - فعال است</p></div>
<div class="card"><b>⚡ Pro Miner</b><p>+5 / sec - قیمت 1000</p><button class="btn" onclick="buyMiner(5,1000,this)">Buy</button></div>
<div class="card"><b>🔥 Mega Miner</b><p>+20 / sec - قیمت 5000</p><button class="btn" onclick="buyMiner(20,5000,this)">Buy</button></div>
</div>

<div id="page-friends" class="hidden">
<div class="header">👥 Friends</div>
<div class="card"><b>دعوت کن و جایزه بگیر!</b><p>هر دوست = +500 BIG</p><button class="btn" onclick="copyLink()">Copy Invite Link</button></div>
</div>

<div id="page-profile" class="hidden">
<div class="header">👤 Profile</div>
<div class="card"><b>Balance:</b> <span id="bal2">0</span> BIG<br><b>Speed:</b> <span id="speed2">1</span> / sec<br><b>Rank:</b> Beginner Miner 🌱</div>
</div>

<div class="nav">
<div onclick="show('mine')"><b>⛏️ Mine</b></div>
<div onclick="show('tasks')"><span>📋 Tasks</span></div>
<div onclick="show('miners')"><span>💎 Miners</span></div>
<div onclick="show('friends')"><span>👥 Friends</span></div>
<div onclick="show('profile')"><span>👤 Profile</span></div>
</div>

<script>
let bal = parseInt(localStorage.getItem('big_bal')||'0');
let perSec = parseInt(localStorage.getItem('big_speed')||'1');
let energy = 1000;
function update(){
document.getElementById('bal').innerText = bal;
document.getElementById('bal2').innerText = bal;
document.getElementById('perSec').innerText = perSec;
document.getElementById('speed2').innerText = perSec;
document.getElementById('energy').innerText = Math.floor(energy);
document.getElementById('energyBar').style.width = (energy/10)+'%';
localStorage.setItem('big_bal', bal);
localStorage.setItem('big_speed', perSec);
}
// AUTO MINING - هر 1 ثانیه خودکار
setInterval(()=>{
if(energy>0){
bal += perSec;
energy -= perSec*0.2;
if(energy<0) energy=0;
} else {
energy += 0.5;
}
update();
},1000);
// Energy کم کم پر میشود
setInterval(()=>{ if(energy<1000){energy+=2; update();} },3000);
function claim(){ bal+=100; alert('🎉 +100 BIG گرفتی!'); update(); }
function boost(){ if(bal>=200){bal-=200; perSec+=1; alert('🚀 سرعت بیشتر شد! حالا '+perSec+'/sec');} else alert('پولت کم است!'); update(); }
function doTask(v,btn){ bal+=v; btn.innerText='✅ Done'; btn.disabled=true; update(); }
function buyMiner(add,price,btn){ if(bal>=price){bal-=price; perSec+=add; btn.innerText='✅ Bought'; btn.disabled=true; alert('خریدی! سرعت شد '+perSec);} else alert('پولت کم است!'); update(); }
function copyLink(){ navigator.clipboard.writeText('https://t.me/yourbot?start=123'); alert('لینک کاپی شد!'); }
function show(p){
['mine','tasks','miners','friends','profile'].forEach(x=>document.getElementById('page-'+x).classList.add('hidden'));
document.getElementById('page-'+p).classList.remove('hidden');
}
update();
</script>
</body>
</html>
